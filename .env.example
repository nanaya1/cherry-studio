NODE_OPTIONS=--max-old-space-size=8000
API_KEY="sk-xxx"
BASE_URL="https://api.siliconflow.cn/v1/"
MODEL="Qwen/Qwen3-235B-A22B-Instruct-2507"
CSLOGGER_MAIN_LEVEL=info
CSLOGGER_RENDERER_LEVEL=info
#CSLOGGER_MAIN_SHOW_MODULES=
#CSLOGGER_RENDERER_SHOW_MODULES=
# Set an absolute root to isolate Cherry home, userData, and logs in development.
#CS_DEV_PROFILE_ROOT=
# Set a unique suffix when running multiple dev instances, e.g. DevQuito.
# Ignored when CS_DEV_PROFILE_ROOT is set.
#CS_DEV_USER_DATA_SUFFIX=
# Use a local Cherry Cloud backend; without this override, the edition's production origin is used.
MAIN_VITE_CHERRY_CLOUD_API_ORIGIN=http://127.0.0.1:8084
# ---------------------------------------------------------------------------
# 服务端地址（部署可配置项，均为构建期注入）
# 企业认证为管理端 PKCE（management-oauth）：/authorize + /api/token，回调 meacowork://auth/sso/callback
# MAIN_VITE_ORG_SERVER_BASE_URL 覆盖管理端地址；未设置时默认回退到旧管理端 http://36.150.116.248:3000
# ---------------------------------------------------------------------------
# Cherry Cloud 账号服务：登录（OAuth/token/刷新）+ 订阅模型请求（/v1/messages 等）
# 默认值按 edition 决定：cn=https://cloud.cherryai.com.cn, global=https://cloud.cherryai.com
# MAIN_VITE_CHERRY_CLOUD_API_ORIGIN=https://cloud.example.com
# 管理端（PKCE 登录 / 技能目录与下载 / 连接器目录）；默认 http://36.150.116.248:3000，可覆盖
# MAIN_VITE_ORG_SERVER_BASE_URL=http://127.0.0.1:3000
# 官网直连相关变量（已停用，仅保留以兼容旧构建脚本）：
# MAIN_VITE_OFFICIAL_API_BASE_URL=http://47.116.35.136
# MAIN_VITE_OFFICIAL_LOGIN_URL=https://www.xuelangyun.com/#/login?source=Cowork
# 雪浪工匠网关：CherryIN/雪浪 OAuth 授权、令牌与余额 API、设置页的授权服务器/充值入口
# 默认值：https://api.xuelanglm.com
# 注意：需在 shell/CI 环境导出（同 CHERRY_EDITION 方式），不能写在 .env 里：
#   XUELANG_API_ORIGIN=https://gw.example.com pnpm build
# ---------------------------------------------------------------------------
# Sentry uses a built-in public DSN; development is disabled and production uploads require user consent.
# Source-map upload is opt-in; release workflows enable it and require the credentials below.
#SENTRY_SOURCE_MAP_UPLOAD=true
#SENTRY_AUTH_TOKEN=
#SENTRY_ORG=
#SENTRY_PROJECT=
